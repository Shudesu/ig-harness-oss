# ===========================================
# Instagram Harness - Environment Variables
# ===========================================
# For Worker: set via `wrangler secret put <NAME>`
# For Web: copy to apps/web/.env.local

# --- Worker (Cloudflare Workers) ---
# Set these with: wrangler secret put <NAME>
API_KEY=your-api-key
IG_ACCESS_TOKEN=your-instagram-access-token
IG_APP_SECRET=your-instagram-app-secret
IG_USER_ID=your-instagram-user-id
IG_VERIFY_TOKEN=your-webhook-verify-token
WORKER_URL=https://your-worker.workers.dev

# --- Web App (Next.js Admin Dashboard) ---
# Copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=https://your-worker.workers.dev

# --- MCP Server ---
# Set in your MCP client config
IG_HARNESS_API_URL=https://your-worker.workers.dev
IG_HARNESS_API_KEY=your-api-key

# Recommended for app secrets / LINE API keys; required for IG access-token writes.
# Base64 of 32 random bytes. Without it, app secrets / LINE keys stay plaintext,
# warn once per isolate, and their scheduled encryption migrations are skipped.
# Legacy derived-key rows still need the original API_KEY / IG_APP_SECRET until
# re-saved with this key. Back up keys; never rotate any encryption source blindly.
TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY
# Exact admin origins, comma-separated. Local dev may use http://localhost:3001.
ADMIN_ORIGIN=https://your-admin.pages.dev
# Explicit opt-in for Pages <-> workers.dev cookie delivery.
ADMIN_ALLOW_CROSS_SITE=true
# Optional: Lax / Strict / None. Cross-site requires None plus opt-in.
# ADMIN_COOKIE_SAMESITE=None
# ADMIN_ORIGINS is accepted only as a legacy alias when ADMIN_ORIGIN is absent.
# Optional: 0 preserves existing history. Set e.g. 180 only after retention approval.
MESSAGES_RETENTION_DAYS=0
IG_USERNAME=your_username
CONTACT_EMAIL=your-contact@example.com
# LINE identity linking requires LINE Harness spec 08 (igt support) or later.
# Must equal LINE-side IG_HARNESS_LINK_SECRET, or use matching IG_LINK_TOKEN_SECRET
# on both sides (same mode). Older receivers redirect but stop identity linking.
LINE_HARNESS_LINK_SECRET=YOUR_RANDOM_SHARED_SECRET
LINE_ADD_URL=
LINE_LIFF_ID=
IG_HARNESS_ACCOUNT_ID=
IG_HARNESS_READ_ONLY=true

# Versioned Graph calls; default is shared by SDK/installer/Worker.
IG_GRAPH_API_VERSION=v25.0
# Enable only when using the correct Instagram App Secret.
IG_REQUIRE_APPSECRET_PROOF=false
